{
  "name": "github-image-lightbox",
  "version": "1.0.0",
  "private": true,
  "description": "Open GitHub images in an in-page lightbox with zoom, pan, and arrow-key navigation.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "bun scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test test/unit",
    "e2e": "bun run build && node test/e2e.mjs",
    "check": "bun run typecheck && bun run test && bun run e2e",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted=false"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/chrome": "latest",
    "fflate": "^0.8.2",
    "playwright": "^1.49.0",
    "typescript": "^5.6.0",
    "web-ext": "^10.7.0"
  }
}
